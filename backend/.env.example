# ============================================================
# TreasuryMind AI – Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ─── Django Core ─────────────────────────────────────────────
SECRET_KEY=your-very-secret-django-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgres://treasurymind_user:treasurymind_pass@localhost:5432/treasurymind
# Individual fields (used if DATABASE_URL is not set)
DB_NAME=treasurymind
DB_USER=treasurymind_user
DB_PASSWORD=treasurymind_pass
DB_HOST=localhost
DB_PORT=5432

# ─── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── Google Gemini API ────────────────────────────────────────
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro

# ─── Email (SMTP) ─────────────────────────────────────────────
# For development, use console backend (no real email sent):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production (Gmail example):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=TreasuryMind AI <noreply@treasurymind.ai>

# ─── JWT Settings ─────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Alert Thresholds ─────────────────────────────────────────
LOW_BALANCE_THRESHOLD=10000
HIGH_OUTFLOW_THRESHOLD=50000
